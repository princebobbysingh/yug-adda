rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isSelf(uid) { return signedIn() && request.auth.uid == uid; }
    function memberOf(communityId) {
      return signedIn() &&
        exists(/databases/$(database)/documents/communities/$(communityId)/members/$(request.auth.uid));
    }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if isSelf(uid);
      allow delete: if isSelf(uid);
    }

    match /communities/{communityId} {
      allow read: if signedIn() && (
        resource.data.visibility == 'public' || memberOf(communityId)
      );
      allow create: if signedIn()
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.visibility in ['public', 'private'];
      allow update, delete: if signedIn() && resource.data.ownerId == request.auth.uid;

      match /members/{uid} {
        allow read: if signedIn() && (uid == request.auth.uid || memberOf(communityId));
        allow create: if isSelf(uid);
        allow update, delete: if isSelf(uid);
      }
    }

    match /posts/{postId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.authorId == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.authorId == request.auth.uid;
    }

    match /polls/{pollId} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if signedIn() && resource.data.createdBy == request.auth.uid;
      match /votes/{uid} {
        allow read: if signedIn();
        allow create, update: if isSelf(uid);
        allow delete: if isSelf(uid);
      }
    }

    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow create: if signedIn() && request.auth.uid in request.resource.data.memberIds;
      allow update: if signedIn() && request.auth.uid in resource.data.memberIds;
      allow delete: if false;
      match /messages/{messageId} {
        allow read: if signedIn() &&
          get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds.hasAny([request.auth.uid]);
        allow create: if signedIn() &&
          request.resource.data.senderId == request.auth.uid &&
          get(/databases/$(database)/documents/chats/$(chatId)).data.memberIds.hasAny([request.auth.uid]);
        allow update, delete: if false;
      }
    }

    match /locationShares/{uid} {
      // Do not enable until consent UX and visibility policy are reviewed.
      allow read, write: if false;
    }
  }
}
